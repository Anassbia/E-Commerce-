<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ category.name }} - Our Store</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand" href="{{ path('store_home') }}">Our Store</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('store_home') }}">Products</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('store_cart') }}">Cart</a>
                    </li>
                    {% include 'store/_auth_nav_links.html.twig' %}
                </ul>
            </div>
        </div>
    </nav>

    <div class="container mt-4">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="{{ path('store_home') }}" class="text-decoration-none">Home</a></li>
                <li class="breadcrumb-item"><a href="{{ path('store_categories') }}" class="text-decoration-none">Categories</a></li>
                <li class="breadcrumb-item active" aria-current="page">{{ category.name }}</li>
            </ol>
        </nav>
    </div>

    <div class="container my-4">
        <div class="p-5 mb-4 bg-primary bg-gradient text-white rounded-3">
            <div class="container-fluid py-3">
                <h1 class="display-4 fw-bold">{{ category.name }}</h1>
                <p class="col-md-8 fs-5">{{ category.description }}</p>
                <span class="badge bg-light text-dark fs-6">{{ products|length }} Products Available</span>
            </div>
        </div>
    </div>

    <div class="container mb-5">
        <div class="row mb-4">
            <div class="col">
                <div class="d-flex justify-content-between align-items-center">
                    <h3>Browse {{ category.name }}</h3>
                    <div class="btn-group" role="group">
                        <button type="button" class="btn btn-outline-secondary active">Grid</button>
                        <button type="button" class="btn btn-outline-secondary">List</button>
                    </div>
                </div>
            </div>
        </div>

        <div class="row row-cols-1 row-cols-md-3 g-4">
            {% for product in products %}
                <div class="col">
                    <div class="card h-100">
                        <img src="{{ product.imageFilename ? asset('assets/images/store/' ~ product.imageFilename) : 'https://via.placeholder.com/500x350' }}" class="card-img-top" alt="{{ product.name }}">
                        <div class="card-body">
                            <span class="badge bg-primary mb-2">{{ category.name }}</span>
                            <h5 class="card-title">{{ product.name }}</h5>
                            <p class="card-text fw-bold text-success">${{ product.price|number_format(2, '.', ',') }}</p>
                            <a href="{{ path('store_product_details', {slug: product.slug}) }}" class="btn btn-outline-primary">View Details</a>
                        </div>
                    </div>
                </div>
            {% else %}
                <div class="col-12">
                    <div class="alert alert-info mb-0">No products are available in this category yet.</div>
                </div>
            {% endfor %}
        </div>

    </div>

    <footer class="bg-dark text-white mt-5 py-4">
        <div class="container">
            <div class="row">
                <div class="col-md-6">
                    <h5>Our Store</h5>
                    <p>Quality products at affordable prices</p>
                </div>
                <div class="col-md-6 text-md-end">
                    <p>&copy; 2024 Our Store. All rights reserved.</p>
                </div>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
