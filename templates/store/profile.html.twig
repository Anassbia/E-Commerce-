<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Profile - Our Store</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand" href="{{ path('store_home') }}">Our Store</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('store_home') }}">Products</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('store_cart') }}">Cart</a>
                    </li>
                    {% include 'store/_auth_nav_links.html.twig' %}
                </ul>
            </div>
        </div>
    </nav>

    <div class="container my-5">
        <div class="row">
            <div class="col-md-3">
                <div class="card">
                    <div class="card-body text-center">
                        <img src="{{ asset('assets/images/store/profile.png') }}" class="rounded-circle mb-3" alt="User Avatar" width="150" height="150">
                        <h5 class="card-title">{{ app.user.fullName }}</h5>
                        <p class="text-muted">{{ app.user.email }}</p>
                        <hr>
                        <ul class="list-unstyled">
                            <li class="mb-2"><a href="#profile" class="text-decoration-none">Profile Information</a></li>
                            <li class="mb-2"><a href="#orders" class="text-decoration-none">My Orders</a></li>
                            <li class="mb-2"><a href="#" class="text-decoration-none">Settings</a></li>
                            <li class="mb-2"><a href="{{ path('store_logout') }}" class="text-decoration-none text-danger">Logout</a></li>
                        </ul>
                    </div>
                </div>
            </div>

            <div class="col-md-9">
                <div class="card mb-4" id="profile">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0">Profile Information</h5>
                    </div>
                    <div class="card-body">
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="fw-bold">Full Name:</label>
                                <p>{{ app.user.fullName }}</p>
                            </div>
                            <div class="col-md-6">
                                <label class="fw-bold">Email:</label>
                                <p>{{ app.user.email }}</p>
                            </div>
                        </div>
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="fw-bold">Phone:</label>
                                <p>Not provided</p>
                            </div>
                            <div class="col-md-6">
                                <label class="fw-bold">Member Since:</label>
                                <p>{{ app.user.createdAt|date('F d, Y') }}</p>
                            </div>
                        </div>
                        <div class="row mb-3">
                            <div class="col-12">
                                <label class="fw-bold">Shipping Address:</label>
                                <p>Not provided in this training step.</p>
                            </div>
                        </div>
                        <button class="btn btn-outline-primary">Edit Profile</button>
                    </div>
                </div>

                <div class="card" id="orders">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0">Order History</h5>
                    </div>
                    <div class="card-body">
                        <div class="alert alert-secondary mb-0">
                            No order history is available in this training step yet.
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <footer class="bg-dark text-white mt-5 py-4">
        <div class="container">
            <div class="row">
                <div class="col-md-6">
                    <h5>Our Store</h5>
                    <p>Quality products at affordable prices</p>
                </div>
                <div class="col-md-6 text-md-end">
                    <p>&copy; 2024 Our Store. All rights reserved.</p>
                </div>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
