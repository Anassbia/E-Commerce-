{% set currentRoute = app.request.attributes.get('_route') %}

{% if app.user %}
    <li class="nav-item">
        <a class="nav-link{{ currentRoute == 'store_profile' ? ' active' : '' }}" href="{{ path('store_profile') }}">Profile</a>
    </li>
    <li class="nav-item">
        <span class="navbar-text text-white">Bienvenue, {{ app.user.fullName }}</span>
    </li>
    <li class="nav-item">
        <a class="nav-link" href="{{ path('store_logout') }}">Logout</a>
    </li>
{% else %}
    <li class="nav-item">
        <a class="nav-link{{ currentRoute == 'store_login' ? ' active' : '' }}" href="{{ path('store_login') }}">Login</a>
    </li>
{% endif %}
